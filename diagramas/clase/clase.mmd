classDiagram
  class Block {
    +id: int
    +hash: str
    +transactions: list
  }
  class Transaction {
    +id: str
    +amount: int
    +signature: bytes
  }
  Block "1" o-- "*" Transaction

  class DualStackNet {
    <<dual_stack.py>>
    +start_stream_server()
    +open_tcp_connection()
    +listen_label()
  }
  class TCPMessageSender
  class TCPMessageReceiver
  class HTTPServer
  class MessageCodec
  TCPMessageSender --> DualStackNet
  TCPMessageReceiver --> DualStackNet
  HTTPServer --> DualStackNet
  TCPMessageSender --> MessageCodec
  TCPMessageReceiver --> MessageCodec

  class NodeService
  class PropagationService
  class MiningService
  NodeService --> TCPMessageSender
  NodeService --> TCPMessageReceiver
  NodeService --> HTTPServer
  NodeService --> PropagationService
  NodeService --> MiningService

  class WalletClient
  class WalletConsole
  class KeyStore
  WalletConsole --> WalletClient
  WalletConsole --> KeyStore
  WalletClient ..> HTTPServer : HTTP
